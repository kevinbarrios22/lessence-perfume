{
  "name": "perfumes-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "node scripts/migrar.mjs",
    "db:logs": "docker compose logs -f db",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker perfumes-mvp-response-store"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@cloudflare/workers-response-store": "^1.1.3",
    "@vinext/cloudflare": "^1.2.1",
    "next": "16.3.4",
    "pg": "^8.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.5",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.23",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module"
}
