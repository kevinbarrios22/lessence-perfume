# PostgreSQL (local con docker compose)
DATABASE_URL=postgresql://parfumerie:parfumerie@127.0.0.1:5434/parfumerie

# Producción: usa la URL que te dé tu hosting (Neon, Railway, Render, VPS, etc.)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Panel de administración
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_SECRET=una-cadena-larga-y-aleatoria-para-firmar-la-sesion

# Cloudflare R2 (almacenamiento de imágenes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parfumerie
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# URL pública del sitio (para Open Graph y enlaces compartidos)
# En producción poné tu dominio, ej: https://perfumeria.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
